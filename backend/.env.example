# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/kiyorax

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Telegram notification bot (optional — enquiries still save if unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
